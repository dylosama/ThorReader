<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One light haptic tick when trying to turn past the first/last page. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Online book info (metadata only: AniList, ComicVine, Open Library). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Trusted import API (step 25): only apps signed with the same key as Thor Reader (Thor
      Bookloader) can hold this permission and so bind to ImportService.
    -->
    <permission
        android:name="dev.thorreader.permission.IMPORT"
        android:label="Import books into Thor Reader"
        android:description="@string/import_permission_description"
        android:protectionLevel="signature" />

    <application
        android:name=".ThorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThorReader">

        <!--
          Top-screen host (display 0). Used for modes 1, 2 and 3.
          Locked to landscape: book modes rotate our own content instead of using auto-rotate.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:resizeableActivity="true"
            android:autoRemoveFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Bottom-screen host (display 4). Used for mode 4 so the top screen is released.
          Separate task affinity so it can live in its own task on the other display.
        -->
        <activity
            android:name=".BottomActivity"
            android:exported="false"
            android:taskAffinity="dev.thorreader.app.bottom"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:resizeableActivity="true"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true" />

        <!-- Trusted import API for Thor Bookloader (signature permission). -->
        <service
            android:name=".importer.ImportService"
            android:exported="true"
            android:permission="dev.thorreader.permission.IMPORT">
            <intent-filter>
                <action android:name="dev.thorreader.action.IMPORT_BOOKS" />
            </intent-filter>
        </service>

        <!-- Thor Bookloader asks for the Imported books folder (signature permission). -->
        <activity
            android:name=".importer.ChooseImportFolderActivity"
            android:exported="true"
            android:permission="dev.thorreader.permission.IMPORT"
            android:theme="@style/Theme.ThorReader"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="dev.thorreader.action.CHOOSE_IMPORT_FOLDER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          "Share" / "Open with" from other apps: confirm screen, then copy + import.
          text/plain and text/html only from VIEW (not SEND, which is mostly shared text).
          Images are not taken from other apps.
        -->
        <activity
            android:name=".importer.ShareImportActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ThorReader"
            android:screenOrientation="landscape"
            android:taskAffinity="dev.thorreader.app.share"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/vnd.amazon.mobi8-ebook" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fb2" />
                <data android:mimeType="application/vnd.ms-xpsdocument" />
                <data android:mimeType="application/oxps" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/x-cb7" />
                <data android:mimeType="application/x-cbt" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/vnd.amazon.mobi8-ebook" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fb2" />
                <data android:mimeType="application/vnd.ms-xpsdocument" />
                <data android:mimeType="application/oxps" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/x-cb7" />
                <data android:mimeType="application/x-cbt" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
            </intent-filter>
            <!-- Unknown MIME type: go by the file extension (the content is checked anyway). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.mobi" />
                <data android:pathPattern=".*\\.azw" />
                <data android:pathPattern=".*\\.azw3" />
                <data android:pathPattern=".*\\.fb2" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\.cbr" />
                <data android:pathPattern=".*\\.cb7" />
                <data android:pathPattern=".*\\.cbt" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\.odt" />
                <data android:pathPattern=".*\\.rtf" />
                <data android:pathPattern=".*\\.xps" />
                <data android:pathPattern=".*\\.oxps" />
            </intent-filter>
        </activity>
    </application>

</manifest>
