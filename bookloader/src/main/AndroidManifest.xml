<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Thor Reader's import permission, declared here too (same name, same signature level, same
      key): whichever app is installed first defines it, so Bookloader always gets it - even when
      it is installed before Thor Reader. Apps signed with any other key still can't.
    -->
    <permission
        android:name="dev.thorreader.permission.IMPORT"
        android:protectionLevel="signature" />
    <!-- Thor Reader's import API: granted only because we're signed with the same key. -->
    <uses-permission android:name="dev.thorreader.permission.IMPORT" />

    <!-- To see (and bind to) Thor Reader on Android 11+. -->
    <queries>
        <package android:name="dev.thorreader.app" />
        <!-- Orbot (Tor), to offer starting it from Settings → Connection. -->
        <package android:name="org.torproject.android" />
    </queries>

    <application
        android:name=".BookloaderApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bookloader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands downloaded files to Thor Reader (read access granted per file, then revoked). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.thorreader.bookloader.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
